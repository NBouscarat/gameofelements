<?xml version="1.0" encoding="UTF-8"?>
<EntityDescriptor xmlns="urn:oasis:names:tc:SAML:2.0:metadata" entityID="https://example.com/sp">
    <SPSSODescriptor
        protocolSupportEnumeration="urn:oasis:names:tc:SAML:2.0:protocol">
        
        <!-- Clé publique pour signer les requêtes -->
        <KeyDescriptor use="signing">
            <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
                <X509Data>
                    <X509Certificate>
                    </X509Certificate>
                </X509Data>
            </KeyInfo>
        </KeyDescriptor>

        <!-- Clé publique pour chiffrer les assertions -->
        <KeyDescriptor use="encryption">
            <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
                <X509Data>
                    <X509Certificate>
                    </X509Certificate>
                </X509Data>
            </KeyInfo>
        </KeyDescriptor>


        <!-- URL pour le Single Logout -->
        <md:SingleLogoutService 
            Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect" 
            Location="https://auth.education.lu/module.php/saml/idp/singleLogout"/>
        
    </SPSSODescriptor>
</EntityDescriptor>